# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (recreated by npm run seed)
/data/*.json
/data/*.tmp
# JSON store ownership lock of the running process (removed on exit)
/data/*.lock

# playwright
/test-results/
/playwright-report/
/data/*/
.neon

# terraform (state lives in S3; never commit local state or provider caches)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# go-live roots: the one per-environment variables file is committed (no secrets in it, see infra/aws/README.md)
!infra/aws/live/*/terraform.tfvars
.terraform.lock.hcl.bak
# saved terraform plans contain resource values (and can contain secrets): never commit them
*.tfplan
tfplan

# Python bytecode caches (e.g. skill scripts)
__pycache__/
*.pyc
