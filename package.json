{
  "name": "barcode_generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "clear-activity": "tsx --env-file-if-exists=.env.local scripts/clear-activity.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:schema": "tsx scripts/db-schema.ts",
    "db:import-json": "tsx --env-file-if-exists=.env.local scripts/db-import-json.ts",
    "db:convert-chain": "tsx --env-file-if-exists=.env.local scripts/convert-chain.ts",
    "test:e2e:postgres": "node scripts/e2e-postgres.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bwip-js": "^4.11.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
