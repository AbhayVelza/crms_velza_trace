# Copy to .env.local and fill in. `npm run dev` / `npm start` and the npm scripts read .env.local.

# ---- Database --------------------------------------------------------------
# Leave empty to keep using data/db.json. When set, the app uses PostgreSQL: on first start it creates the
# tables (db/schema.sql) and two sign-ins, Velza Admin AD0001 and Velza HQ HQ0001 (passwords below, or
# generated and printed once in the server log). Managed services (Supabase, Neon, AWS RDS …) need SSL:
# add ?sslmode=require (or what the provider's connection string says).
DATABASE_URL=
# Connections per app server (default 10). Keep the total under the database's limit.
PG_POOL_MAX=10

# Try the database code without a server: embedded PostgreSQL kept in a folder.
# STORE=pglite
# PGLITE_DIR=data/pg

# ---- Sign-in -----------------------------------------------------------------------
# off = pick who to act as, no password (development). Default: off under `npm run dev`, on under `npm start`.
# SIGN_IN=off

# ---- First sign-ins (clean start / npm run seed) -------------------------------
# Leave empty to get random ones printed once. Change them after the first sign-in either way.
VELZA_ADMIN_PASSWORD=
VELZA_HQ_PASSWORD=

# ---- Server (see SECURITY.md) --------------------------------------------------
# HTTPS_ONLY=1                 # served over HTTPS: HSTS + upgrade-insecure-requests
# CLIENT_IP_HEADER=cf-connecting-ip   # the header your proxy sets with the real client IP
# NEXT_PUBLIC_DEMO_HELPER=1    # keep the click-to-scan demo helper in a production build
