# Copy to .env.local and fill in. `npm run dev` / `npm start` and the npm scripts read .env.local.

# ---- Database --------------------------------------------------------------
# Leave empty to keep using data/db.json. When set, the app uses PostgreSQL: on first start it creates the
# tables (db/schema.sql) and two sign-ins, Velza Admin AD0001 and Velza HQ HQ0001 (passwords below, or
# generated and printed once in the server log). Managed services (Supabase, Neon, AWS RDS …) need SSL:
# add ?sslmode=require (or what the provider's connection string says).
# On a laptop: your own dev database or Neon dev branch, NEVER the production one (see docs/DEPLOYMENT.md).
# In production: the velza_app role (deploy/roles_v11.sql); migrations use the owner role (MIGRATE_DATABASE_URL in /srv/velza/migrate.env during a deploy).
DATABASE_URL=
# Connections per app server (default 10; 3 on Vercel). Keep the total under the database's limit.
PG_POOL_MAX=10
# Time limit for `npm run db:stock -- check | rebuild`, which read every code (a PostgreSQL interval; default 30min).
# VELZA_JOB_STATEMENT_TIMEOUT=30min
# A direct (non-pooled) address used ONLY for code allocation (print orders), which holds a session-level lock
# that a transaction-mode pooler can't keep. Neon's integration on Vercel sets it, and DATABASE_URL to the pooled
# address used for everything else (see docs/VERCEL.md). Leave it unset locally and on Docker / Lightsail: then
# everything uses DATABASE_URL and one pool.
# DATABASE_URL_UNPOOLED=
# Connections per app server to DATABASE_URL_UNPOOLED, when it is set (default 2).
# PG_LOCK_POOL_MAX=2
# Where damage photos are stored (default data/uploads; on Vercel /tmp/velza-uploads, temporary: see docs/VERCEL.md).
# VELZA_UPLOAD_DIR=

# Try the database code without a server: embedded PostgreSQL kept in a folder.
# STORE=pglite
# PGLITE_DIR=data/pg

# ---- Sign-in -----------------------------------------------------------------------
# off = pick who to act as, no password (development). Default: off under `npm run dev`, on under `npm start`.
# SIGN_IN=off

# ---- First sign-ins (clean start / npm run seed) -------------------------------
# Leave empty to get random ones printed once. Change them after the first sign-in either way.
VELZA_ADMIN_PASSWORD=
VELZA_HQ_PASSWORD=

# ---- Server (see SECURITY.md) --------------------------------------------------
# HTTPS_ONLY=1                 # served over HTTPS: HSTS + upgrade-insecure-requests
# CLIENT_IP_HEADER=cf-connecting-ip   # the header your proxy sets with the real client IP
# NEXT_PUBLIC_DEMO_HELPER=1    # keep the click-to-scan demo helper in a production build
