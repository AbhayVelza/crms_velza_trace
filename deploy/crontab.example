# Scheduled jobs for the app server. Install as the `velza` user: crontab deploy/crontab.example
# (adjust the paths first). Logs go to /srv/velza/shared/logs; rotate them with logrotate.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Every minute: fold stock_deltas into stock_summary (live counts are exact either way; this keeps the deltas small).
* * * * *  cd /srv/velza/current && npm run -s db:stock -- rollup >> /srv/velza/shared/logs/stock.log 2>&1

# Nightly 02:40: compare the live stock summary with a full recount; a non-zero exit means "investigate, then rebuild".
# Wire the failure to your alerting (e.g. a healthchecks.io / Better Stack heartbeat that is pinged only on success).
40 2 * * *  cd /srv/velza/current && npm run -s db:stock -- check >> /srv/velza/shared/logs/stock-check.log 2>&1
